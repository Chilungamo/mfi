APP_ENV=development
APP_NAME=AL-MFI-001
APP_VERSION=0.2.0

# PostgreSQL (docker compose service "postgres")
DATABASE_URL=postgresql+psycopg://al_mfi:al_mfi@localhost:5432/al_mfi
# Read-only API connection; leave unset locally to reuse DATABASE_URL
# API_DATABASE_URL=postgresql+psycopg://mmd_api:...@localhost:5432/al_mfi

# Raw archive (docker compose service "storage" = MinIO). Change both keys.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=al-mfi-raw
S3_ACCESS_KEY=change-me-access
S3_SECRET_KEY=change-me-secret-at-least-8-chars

# Identify the project to source websites; use a real contact address.
USER_AGENT=AL-MFI-001-research/0.2 (contact: you@example.org)
EXTRACTOR_VERSION=0.1.0
